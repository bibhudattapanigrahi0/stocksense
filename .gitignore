# Secrets / local env — never commit
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenv
env/
venv/
.venv/

# Runtime state — regenerated by the app; NOT source. Includes the 1.1 GB diskcache,
# the SQLite DB (user accounts/watchlists/paper/alerts — private data), and generated
# backtest results & reports. Fresh clones rebuild these by running the pipeline.
data/

# Runtime logs (launchd app/backtest output — may contain ledger/alert data)
logs/

# Local tool/editor state
.claude/settings.local.json
.ipynb_checkpoints/
.DS_Store
