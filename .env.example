# ── LLM provider ──────────────────────────────────────────────────
# "none" (default) = rules-only mode: no LLM calls, fully deterministic.
# "openai" | "anthropic" | "gemini" | "ollama" enable NL query parsing,
# moat/sentiment narratives, and LLM-written executive summaries in reports.
llm_provider=none

# openai_api_key=
# anthropic_api_key=
# gemini_api_key=          # Google AI Studio key; Gemini uses its OpenAI-compatible API (no extra deps)
# ollama_base_url=http://localhost:11434
# gemini_base_url=https://generativelanguage.googleapis.com/v1beta/openai/
# llm_model=gpt-4o-mini    # for gemini, set e.g. gemini-2.5-flash or gemini-2.5-pro (else defaults to gemini-2.5-flash)

# ── SEC EDGAR institutional data (13F) ───────────────────────────
# Free historical institutional holdings for US stocks. SEC REQUIRES a User-Agent
# with real contact info on every request — set yours so you aren't rate-limited.
# sec_user_agent=YourApp/1.0 (you@example.com)
# openfigi_api_key=          # optional — free CUSIP↔ticker mapping works without a key; a key raises the limit

# ── Screening defaults ────────────────────────────────────────────
# default_index=NIFTY 50
# max_candidates=20
# analysis_depth=standard

# ── Concurrency ───────────────────────────────────────────────────
# ingestion_concurrency=8
# analysis_concurrency=6

# ── Composite weights (must sum to 1.0) ──────────────────────────
# weight_fundamental=0.40
# weight_technical=0.30
# weight_sentiment=0.15
# weight_risk=0.15

# ── Reports ───────────────────────────────────────────────────────
# report_top_n=1

# ── Accounts & sessions (dashboard login) ─────────────────────────
# The dashboard requires a login; each account's data (portfolios, watchlist,
# paper, screens, alerts) is private. The first sign-up claims the "owner"
# account and inherits any pre-accounts data. The MCP server acts as the owner.
# auth_allow_signup=true          # set false to lock the server to existing users
# auth_session_ttl_days=30
# auth_cookie_secure=false        # set true when served over HTTPS (hosting)
# Optional: bootstrap the owner's credentials from the environment instead of
# claiming it via the first sign-up.
# owner_email=you@example.com
# owner_password=change-me-to-something-long

# ── Storage location (defaults to ./data) ────────────────────────
# STOCKSENSE_DATA_DIR=/path/to/data
